# macOS
.DS_Store
**/.DS_Store

# Xcode build artifacts & user state
build/
DerivedData/

# xtool / SwiftPM on Linux
.build/
.bsp/
/xtool/
*.xcuserstate
**/xcuserdata/
*.xcuserdatad/
*.moved-aside

# Claude Code local state (worktrees, caches)
.claude/

# Impeccable skill working files (logo scratch, review screenshots)
.impeccable/

# Python backend virtualenv & temp
**/.venv/
**/__pycache__/
*.pyc
whisper-transcriber/.tmp/

# Secrets — never commit auth cookies, env, or keys
**/cookies.txt
**/cookies/
*.env
.env.*

# Per-developer signing (machine-specific team id)
Config/Local.xcconfig

# scratch/patch helpers (do not commit)
/patch*.py
/test_*.swift
/fix_*.py
*.tailspin

# Cursor editor local settings
.cursor/

# Xcode crash + runloop logs that appear in AICookBookTests
AICookBookTests/*.ips
AICookBookTests/*.tailspin.gz
